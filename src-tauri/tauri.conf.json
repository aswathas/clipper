{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "0.3.0",
  "identifier": "io.clipper.app",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
